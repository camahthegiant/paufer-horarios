# Base de datos
POSTGRES_USER=paufer
POSTGRES_PASSWORD=CAMBIAR_CONTRASEÑA_SEGURA
POSTGRES_DB=paufer
# Superuser — solo Alembic (DDL). No usar en runtime.
DATABASE_URL=postgresql://paufer:CAMBIAR_CONTRASEÑA_SEGURA@db:5432/paufer
# App user (no superuser) — la app usa este para que RLS sea efectivo.
POSTGRES_APP_PASSWORD=CAMBIAR_CONTRASEÑA_APP_SEGURA
APP_DATABASE_URL=postgresql://paufer_app:CAMBIAR_CONTRASEÑA_APP_SEGURA@db:5432/paufer

# Backend
SECRET_KEY=CAMBIAR_SECRET_KEY_LARGA_Y_ALEATORIA
BOOTSTRAP_SECRET=CAMBIAR_BOOTSTRAP_SECRET
ENVIRONMENT=production
CORS_ORIGINS=https://app.paufer.es

# Frontend — apuntar al dominio real del backend
NEXT_PUBLIC_API_URL=https://api.paufer.es
NEXTAUTH_SECRET=CAMBIAR_NEXTAUTH_SECRET
NEXTAUTH_URL=https://app.paufer.es

# Google Calendar (opcional, dejar vacío si no se usa)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
