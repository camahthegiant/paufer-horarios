# PostgreSQL
POSTGRES_USER=paufer
POSTGRES_PASSWORD=changeme
POSTGRES_DB=paufer
# Superuser — solo Alembic (DDL). No cambiar este usuario.
DATABASE_URL=postgresql://paufer:changeme@db:5432/paufer
# App user (no superuser) — la app usa este para que RLS sea efectivo.
POSTGRES_APP_PASSWORD=changeme_app
APP_DATABASE_URL=postgresql://paufer_app:changeme_app@db:5432/paufer

# Backend
SECRET_KEY=changeme-generate-a-real-secret
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=changeme
NEXTAUTH_URL=http://localhost:3000

# Google Calendar API (Domain-Wide Delegation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
